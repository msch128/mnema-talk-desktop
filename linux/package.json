{
  "name": "mnema-desktop-linux",
  "productName": "Mnema Desktop DEV",
  "description": "Mnema Talk desktop client for Linux (Electron). Runs only the signed web bundle.",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Mnema Talk <noreply@users.noreply.github.com>",
  "homepage": "https://github.com/msch128/mnema-talk-desktop",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"test/*.test.ts\"",
    "vectors": "node scripts/gen-vectors.ts",
    "vectors:check": "node scripts/gen-vectors.ts --check",
    "start": "npm run build && electron .",
    "check": "npm run lint && npm run typecheck && npm run vectors:check && npm test && npm run build",
    "e2e": "npm run build && node --test --test-timeout=120000 \"test/e2e/*.e2e.ts\""
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "desktopName": "mnema-desktop-dev.desktop"
}
