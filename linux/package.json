{
  "name": "mnema-desktop-linux",
  "productName": "Mnema Desktop",
  "description": "Mnema Talk desktop client for Linux (Electron). Runs only the signed web bundle.",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Mnema Talk <noreply@users.noreply.github.com>",
  "homepage": "https://github.com/msch128/mnema-talk-desktop",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"test/*.test.ts\"",
    "vectors": "node scripts/gen-vectors.ts",
    "vectors:check": "node scripts/gen-vectors.ts --check",
    "start": "npm run build && electron .",
    "check": "npm run lint && npm run typecheck && npm run vectors:check && npm test && npm run build",
    "e2e": "npm run build && node --test --test-timeout=120000 \"test/e2e/*.e2e.ts\""
  },
  "dependencies": {
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "desktopName": "mnema-desktop-dev.desktop",
  "overrides": {
    "minimatch@>=7 <11": "11.0.5"
  }
}
