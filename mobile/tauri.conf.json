{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnema Talk Preview",
  "identifier": "com.mnema.talk.preview",
  "version": "0.1.0",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["mobile"],
      "csp": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../icons/icon.png"],
    "iOS": {
      "minimumSystemVersion": "17.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
